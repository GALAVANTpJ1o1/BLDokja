{
  "name": "@bld/storage",
  "version": "0.1.0",
  "private": true,
  "description": "StorageAdapter port, versioned local schema, IndexedDB and memory backends, JSON export/import, and the legacy LetterPairTrainer importer.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./dexie": {
      "types": "./src/dexie-backend.ts",
      "import": "./src/dexie-backend.ts"
    },
    "./legacy": {
      "types": "./src/legacy/index.ts",
      "import": "./src/legacy/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "import:legacy": "tsx scripts/import-legacy-letterpairs.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "sql.js": "1.14.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/sql.js": "1.4.11",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
