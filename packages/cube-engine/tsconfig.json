{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Editor and lint view: tests and scripts may use Node (fs, process).
    // Engine purity is checked separately by tsconfig.build.json, which has no Node or DOM types.
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
