{
  "name": "@bld/srs",
  "version": "0.1.0",
  "private": true,
  "description": "FSRS scheduling for drill cases, derived from the event log.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
